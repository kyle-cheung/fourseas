# Copy this file to .env and put your own values in it. Do not commit .env.
# Get the keys from https://dashboard.plaid.com/developers/keys

PLAID_CLIENT_ID=
PLAID_SECRET=

# "sandbox" uses fake data and needs no approval.
# "production" uses your real cards. The sandbox and production secrets differ.
PLAID_ENV=sandbox

# Banks that use OAuth, such as Scotiabank, need a redirect URI.
# First register this exact value in the Plaid dashboard, under
# Team Settings > API > Allowed redirect URIs. Then remove the # below.
# Leave it unset for banks that do not use OAuth, such as American Express.
#PLAID_REDIRECT_URI=http://localhost:8080/oauth

# Optional. Change the port only if 8080 is busy. The redirect URI above must
# use the same port.
#PROBE_LINK_PORT=8080

# Optional file locations.
#PROBE_DB_PATH=data/providence.duckdb
#PROBE_TOKENS_PATH=.secrets/tokens.json
